APP_NAME=SignaturePOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=signature_pos
DB_USERNAME=signature
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@signature.test
MAIL_FROM_NAME="${APP_NAME}"

# Low-stock alert email (branch manager receives this)
LOW_STOCK_ALERT_EMAIL=manager@signature.test
